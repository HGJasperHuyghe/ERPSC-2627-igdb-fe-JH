### Get top 10 games
GET http://localhost:4004/odata/v4/game/Game?$top=10

### Get All Students (actieve versies)
GET http://localhost:4004/odata/v4/game/Student?$filter=IsActiveEntity eq true

### Get a student with their favorite games
GET http://localhost:4004/odata/v4/game/Student(Student_ID=fe56efd2-85a2-4928-8127-af094a6d4653,IsActiveEntity=true)?$expand=to_favos($expand=to_game)

# -----------------------------------------------------------------------------
# Student is draft-enabled: wijzigen gebeurt via een draft (zoals de Fiori app doet)
# -----------------------------------------------------------------------------

### 1. Create a new student (maakt een draft aan)
# @name newStudent
POST http://localhost:4004/odata/v4/game/Student
Content-Type: application/json

{
  "First_name": "John",
  "Last_name": "Doe"
}

### 2. Add a favorite game to the draft
POST http://localhost:4004/odata/v4/game/Student(Student_ID={{newStudent.response.body.Student_ID}},IsActiveEntity=false)/to_favos
Content-Type: application/json

{
  "Game_ID": 1
}

### 3. Activate (save) the draft
POST http://localhost:4004/odata/v4/game/Student(Student_ID={{newStudent.response.body.Student_ID}},IsActiveEntity=false)/GameService.draftActivate
Content-Type: application/json

{}

### Edit an existing student: start een draft
POST http://localhost:4004/odata/v4/game/Student(Student_ID=fe56efd2-85a2-4928-8127-af094a6d4653,IsActiveEntity=true)/GameService.draftEdit
Content-Type: application/json

{ "PreserveChanges": true }

### Patch the draft
PATCH http://localhost:4004/odata/v4/game/Student(Student_ID=fe56efd2-85a2-4928-8127-af094a6d4653,IsActiveEntity=false)
Content-Type: application/json

{
  "First_name": "Tom2",
  "Last_name": "Antjon2"
}

### Activate the edited draft
POST http://localhost:4004/odata/v4/game/Student(Student_ID=fe56efd2-85a2-4928-8127-af094a6d4653,IsActiveEntity=false)/GameService.draftActivate
Content-Type: application/json

{}

### Delete a student
DELETE http://localhost:4004/odata/v4/game/Student(Student_ID=450fed61-a0d0-43d8-ab8c-ae394a78b476,IsActiveEntity=true)

### Try to delete a game (read-only -> 405)
DELETE http://localhost:4004/odata/v4/game/Game(1)
